# ============================================================================
# Copy to .env.local and fill in. Never commit .env.local.
#
# Only the Supabase block is needed to run M0/M1. Everything below it is
# commented until the milestone that needs it.
# ============================================================================

# ── Supabase (required) ─────────────────────────────────────────────────────
# Project settings -> API. Create the project in ap-south-1 (Mumbai).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row-level security entirely. Server-side only, never NEXT_PUBLIC_,
# and referenced by exactly one file (lib/db/admin.ts) — `npm run
# guard:service-role` fails the build if that stops being true.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for pg_cron -> /api/jobs/* calls, so the job endpoints cannot
# be triggered by anyone who guesses the URL. Generate: openssl rand -hex 32
CRON_SECRET=


# ── M3: WhatsApp via Meta Cloud API (direct, no BSP) ────────────────────────
# Tech Provider + Embedded Signup, so each gym's WABA lives in their own
# Business Manager. Saves the ~₹2,500/mo BSP fee and ~26% per utility message.
# META_APP_ID=
# META_APP_SECRET=
# META_SYSTEM_USER_TOKEN=
# META_WEBHOOK_VERIFY_TOKEN=

# ── M3: SMS via MSG91 (DLT-registered) ──────────────────────────────────────
# Transactional and OTP only; marketing goes over WhatsApp.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_DLT_TE_ID=

# ── M3: email via Resend ────────────────────────────────────────────────────
# RESEND_API_KEY=
# RESEND_FROM="Fitwell <noreply@yourdomain.in>"

# ── M3: Web Push (VAPID, no vendor) ─────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.in

# ── M4: Razorpay Partner (sub-merchant onboarding) ──────────────────────────
# Each gym's funds settle to their OWN account, so the platform never holds
# money and stays outside RBI payment-aggregator licensing.
# RAZORPAY_PARTNER_KEY_ID=
# RAZORPAY_PARTNER_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── M5: object storage (Cloudflare R2) ──────────────────────────────────────
# Exercise video and nightly pg_dump backups. Supabase Storage keeps the
# sensitive files (progress photos, waivers) where RLS applies; R2 takes the
# bandwidth-heavy ones because its egress is free.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# ── observability ───────────────────────────────────────────────────────────
# SENTRY_DSN=
# HEALTHCHECKS_PING_URL=
